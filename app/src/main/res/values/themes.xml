<resources>
    <style name="Theme.QuestBlock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- no system "preview" window: the app paints its own background straight away -->
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- Lock page: same, opens straight into the chosen theme -->
    <style name="Theme.QuestBlock.Lock" parent="Theme.QuestBlock" />

    <!-- v213: Quest Home. Transparent window that shows the phone wallpaper; the other wall modes paint over it. -->
    <style name="Theme.QuestBlock.Home" parent="Theme.QuestBlock">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
